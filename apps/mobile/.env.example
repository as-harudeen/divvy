# Required — Supabase project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required — Supabase project anon key (public, ships in the JS bundle)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: anything prefixed EXPO_PUBLIC_ is inlined into the bundle and is
# therefore public. Never put service-role keys here. Service-role operations
# must run inside a Supabase Edge Function or your own backend, never on device.
